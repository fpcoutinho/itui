# Copie para `.env.local` (ignorado pelo git) e ajuste.
#
# Só variáveis com o prefixo VITE_ chegam ao código do navegador. Nenhum segredo
# entra aqui: tudo com esse prefixo vai para o bundle de produção em texto claro.
# `RAIJIN_ORIGIN` não tem o prefixo — é lida só pelo vite.config.ts, em Node.

# Origem do raijin para onde o proxy do dev server encaminha `/api`.
# Só vale em desenvolvimento; em produção não existe proxy.
RAIJIN_ORIGIN=http://localhost:3000

# Base da API usada pelo código do navegador, SEM o /api/v1.
#
# VAZIO (padrão em dev) = caminho relativo, resolvido pelo proxy acima. Same-origin:
# sem CORS e com o cookie de refresh como first-party.
#
# PREENCHIDO (ex.: https://api.seudominio.com) = chamada direta cross-origin, que é
# o modo de produção. Use para reproduzir o caminho real da sessão — nesse modo a
# origem do front precisa estar em CORS_ALLOWED_ORIGINS no .env do raijin.
VITE_API_BASE_URL=

# Client ID do Google Identity Services. NÃO é segredo — vai no bundle por
# design. Precisa ser exatamente o mesmo GOOGLE_CLIENT_ID do .env do raijin: é
# a audience que o backend valida no ID Token. Divergente = 401 em todo login
# com Google.
VITE_GOOGLE_CLIENT_ID=
